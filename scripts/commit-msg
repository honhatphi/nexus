#!/usr/bin/env bash
# ─── Conventional Commits — commit-msg hook ───────────────────────────────────
# Format: <type>(<scope>): <description>
#
# Types    : feat | fix | chore | docs | refactor | test | ci | perf | style | revert
# Scopes   : devcontainer | mcp-server | common-tools | nexus-hub | infra | workspace | deps | release
# Examples :
#   feat(mcp-server): add impact analysis endpoint
#   fix(devcontainer): correct container DNS for memgraph
#   chore(deps): upgrade npm to 11.12.1
#   docs(nexus-hub): update knowledge-base patterns
# ─────────────────────────────────────────────────────────────────────────────

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip merge commits, fixup, squash
if echo "$COMMIT_MSG" | grep -qE "^(Merge|Revert|fixup!|squash!|Rebase)"; then
  exit 0
fi

PATTERN="^(feat|fix|chore|docs|refactor|test|ci|perf|style|revert)(\([a-z0-9\-]+\))?: .{1,100}$"

if ! echo "$COMMIT_MSG" | head -1 | grep -qE "$PATTERN"; then
  echo ""
  echo "  ❌  Commit message does not follow Conventional Commits format."
  echo ""
  echo "  Format  : <type>(<scope>): <short description>"
  echo "  Types   : feat | fix | chore | docs | refactor | test | ci | perf | style | revert"
  echo "  Scopes  : devcontainer | mcp-server | common-tools | nexus-hub | infra | workspace | deps | release"
  echo ""
  echo "  ✅ Examples:"
  echo "     feat(mcp-server): add semantic search endpoint"
  echo "     fix(devcontainer): correct memgraph container DNS"
  echo "     chore(deps): upgrade npm to 11.12.1"
  echo "     docs(nexus-hub): add api-design pattern"
  echo ""
  echo "  ✏️  Your message: $(head -1 "$COMMIT_MSG_FILE")"
  echo ""
  exit 1
fi

exit 0
