#!/usr/bin/env bash
# ─── Nexus KB — global post-merge hook ───────────────────────────────────────
# Runs after `git pull` / `git merge` when new commits were merged in.
# $1 = 1 if squash merge, 0 if regular merge (either way: new code arrived).
# Triggers an incremental KB sync in the background — never blocks pull.
# ─────────────────────────────────────────────────────────────────────────────

# Resolve the repo root
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# Find node — check nvm, homebrew, and system paths
_find_node() {
  if command -v node &>/dev/null; then
    command -v node
    return
  fi
  local nvm_dir="${NVM_DIR:-${HOME}/.nvm}/versions/node"
  if [ -d "$nvm_dir" ]; then
    local latest
    latest="$(ls -1 "$nvm_dir" 2>/dev/null | sort -V | tail -1)"
    [ -n "$latest" ] && echo "${nvm_dir}/${latest}/bin/node" && return
  fi
  for p in /opt/homebrew/bin/node /usr/local/bin/node; do
    [ -x "$p" ] && echo "$p" && return
  done
}

NODE="$(_find_node)"
if [ -z "$NODE" ] || [ ! -x "$NODE" ]; then
  echo "[nexus-kb] warning: node not found — skipping KB sync for ${REPO_ROOT}" \
    >> "${HOME}/.nexus/sync.log" 2>&1
  exit 0
fi

# Fire-and-forget
nohup "$NODE" "${HOME}/.nexus/sync-kb.mjs" "$REPO_ROOT" \
  >> "${HOME}/.nexus/sync.log" 2>&1 &

exit 0
