<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nexus.consolidation</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/CPS-MKT1-D02072/Workspace/Nexus/scripts/consolidation.mjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/CPS-MKT1-D02072/Workspace/Nexus</string>

    <!-- Run daily at 02:00 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/nexus-consolidation.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/nexus-consolidation.err</string>
</dict>
</plist>
