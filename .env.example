# ─── Environment ────────────────────────────────────────────
NODE_ENV=development

# ─── Memgraph (Graph Database) ──────────────────────────────
MEMGRAPH_VERSION=latest
MEMGRAPH_BOLT_PORT=17687
MEMGRAPH_WEB_PORT=13000
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ─── ChromaDB (Vector Database) ─────────────────────────────
CHROMADB_VERSION=latest
CHROMADB_PORT=18000
CHROMADB_TELEMETRY=FALSE
CHROMADB_TOKEN=
CHROMADB_AUTH_PROVIDER=

# ─── MCP Server (Node.js) ──────────────────────────────────
MCP_SERVER_PORT=13100
