# =============================================================
# Nexus MCP Server — Biến môi trường
#
# Cách dùng:
#   cp .env.example .env
#   # Chỉnh sửa .env theo môi trường của bạn
#   # File .env đã được gitignore — KHÔNG commit credentials.
#
# Quy ước:
#   - Biến có giá trị sẵn  → đang dùng giá trị mặc định, bỏ
#                             comment nếu muốn override.
#   - Biến bị comment (#)  → optional, chỉ set khi cần thay đổi.
# =============================================================


# ─────────────────────────────────────────────────────────────
# Infrastructure — Memgraph (graph store)
#
# Memgraph chạy qua Docker Compose (xem docker-compose.yml).
# Thay đổi port nếu bạn chạy Memgraph bên ngoài Docker.
# ─────────────────────────────────────────────────────────────
MEMGRAPH_URI=bolt://localhost:17687
# MEMGRAPH_USER=
# MEMGRAPH_PASSWORD=


# ─────────────────────────────────────────────────────────────
# Infrastructure — ChromaDB (vector store)
#
# ChromaDB chạy qua Docker Compose (xem docker-compose.yml).
# CHROMADB_TOKEN chỉ cần set nếu ChromaDB được bảo vệ bằng auth.
# CHROMADB_COLLECTION là tên collection lưu embeddings code.
# ─────────────────────────────────────────────────────────────
CHROMADB_URL=http://localhost:18000
# CHROMADB_TOKEN=
CHROMADB_COLLECTION=nexus_codebase


# ─────────────────────────────────────────────────────────────
# MCP Server
#
# Port HTTP mà MCP server lắng nghe.
# Codex CLI kết nối tới: http://localhost:<MCP_SERVER_PORT>/mcp
# ─────────────────────────────────────────────────────────────
MCP_SERVER_PORT=13100


# ─────────────────────────────────────────────────────────────
# Nexus — Dữ liệu local
#
# NEXUS_DATA_DIR   : Thư mục gốc cho toàn bộ dữ liệu local của
#                    Nexus (ledger, artifact, context pack, index
#                    state, task workspace).
#                    Mặc định: ~/.nexus
#
# NEXUS_WORKSPACE_ID : ID workspace dùng khi caller không truyền
#                      workspace_id. Mỗi project/repo nên có ID
#                      riêng để tránh xung đột dữ liệu.
#                      Mặc định: default
# ─────────────────────────────────────────────────────────────
# NEXUS_DATA_DIR=~/.nexus
NEXUS_WORKSPACE_ID=default


# ─────────────────────────────────────────────────────────────
# Token budget
#
# Kiểm soát lượng token được đưa vào context của agent.
# Tăng nếu model hỗ trợ context window lớn hơn.
# Giảm nếu muốn tiết kiệm token / tăng tốc độ phản hồi.
#
# NEXUS_DEFAULT_MAX_INPUT_TOKENS : Số token tối đa cho input
#   của context pack (nexus_build_context_pack).
#   Mặc định: 12000
#
# NEXUS_DEFAULT_RESERVED_TOKENS  : Token dành riêng cho phần
#   reply của model (không được dùng cho input).
#   Mặc định: 3000
#
# NEXUS_TASK_MAX_INPUT_TOKENS    : Budget cho context pack khi
#   spawn task workspace (nexus_spawn_task_workspace). Thường
#   lớn hơn default vì task workspace cần nhiều context hơn.
#   Mặc định: 16000
# ─────────────────────────────────────────────────────────────
NEXUS_DEFAULT_MAX_INPUT_TOKENS=12000
NEXUS_DEFAULT_RESERVED_TOKENS=3000
NEXUS_TASK_MAX_INPUT_TOKENS=16000


# ─────────────────────────────────────────────────────────────
# Feature flags
#
# NEXUS_ENABLE_LEGACY_TOOLS : Bật các tool low-level cũ để tương
#   thích ngược với các workflow có sẵn.
#   Các tool được bật thêm khi = 1:
#     - query_graph
#     - search_knowledge_base
#     - get_impact_analysis
#     - check_staleness
#     - parse_code
#     - sync_service_knowledge
#     - augment
#     - get_process_flows
#   Mặc định: 0 (tắt) — chỉ dùng high-level tools mới.
# ─────────────────────────────────────────────────────────────
NEXUS_ENABLE_LEGACY_TOOLS=0
